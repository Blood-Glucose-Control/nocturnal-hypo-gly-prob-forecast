{
  "additionalProperties": false,
  "description": "Schema contract for GBM tabular (AutoGluon backend) YAML configs.\n\nWraps AutoGluon's RecursiveTabular / DirectTabular reductions with a\ngradient-boosting backend (LightGBM / CatBoost / XGBoost).",
  "properties": {
    "backend": {
      "default": "lightgbm",
      "enum": [
        "lightgbm",
        "catboost",
        "xgboost"
      ],
      "title": "Backend",
      "type": "string"
    },
    "context_length": {
      "default": 288,
      "exclusiveMinimum": 0,
      "title": "Context Length",
      "type": "integer"
    },
    "covariate_cols": {
      "items": {
        "type": "string"
      },
      "title": "Covariate Cols",
      "type": "array"
    },
    "differences": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Differences"
    },
    "enable_ensemble": {
      "default": false,
      "title": "Enable Ensemble",
      "type": "boolean"
    },
    "eval_metric": {
      "default": "WQL",
      "minLength": 1,
      "title": "Eval Metric",
      "type": "string"
    },
    "forecast_length": {
      "default": 24,
      "exclusiveMinimum": 0,
      "title": "Forecast Length",
      "type": "integer"
    },
    "imputation_threshold_mins": {
      "default": 45,
      "exclusiveMinimum": 0,
      "title": "Imputation Threshold Mins",
      "type": "integer"
    },
    "interval_mins": {
      "default": 5,
      "exclusiveMinimum": 0,
      "title": "Interval Mins",
      "type": "integer"
    },
    "lags": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lags"
    },
    "max_num_items": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Num Items"
    },
    "max_num_samples": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Num Samples"
    },
    "min_segment_length": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Segment Length"
    },
    "model_hyperparameters": {
      "additionalProperties": true,
      "title": "Model Hyperparameters",
      "type": "object"
    },
    "model_type": {
      "const": "gbm",
      "default": "gbm",
      "title": "Model Type",
      "type": "string"
    },
    "patient_col": {
      "default": "patient_id",
      "minLength": 1,
      "title": "Patient Col",
      "type": "string"
    },
    "quantile_levels": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantile Levels"
    },
    "strategy": {
      "default": "recursive",
      "enum": [
        "recursive",
        "direct"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "target_col": {
      "default": "bg_mM",
      "minLength": 1,
      "title": "Target Col",
      "type": "string"
    },
    "target_scaler": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Scaler"
    },
    "time_col": {
      "default": "datetime",
      "minLength": 1,
      "title": "Time Col",
      "type": "string"
    },
    "time_limit": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Limit"
    },
    "training_mode": {
      "default": "from_scratch",
      "title": "Training Mode",
      "type": "string"
    }
  },
  "title": "GBMModelConfigSchema",
  "type": "object"
}
