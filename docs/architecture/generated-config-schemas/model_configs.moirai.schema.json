{
  "additionalProperties": false,
  "description": "Schema contract for Moirai model YAML configs.",
  "properties": {
    "batch_size": {
      "default": 64,
      "exclusiveMinimum": 0,
      "title": "Batch Size",
      "type": "integer"
    },
    "checkpoint_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Path"
    },
    "context_length": {
      "default": 512,
      "exclusiveMinimum": 0,
      "title": "Context Length",
      "type": "integer"
    },
    "covariate_cols": {
      "items": {
        "type": "string"
      },
      "title": "Covariate Cols",
      "type": "array"
    },
    "finetune_pattern": {
      "default": "full",
      "enum": [
        "full",
        "freeze_ffn",
        "head_only"
      ],
      "title": "Finetune Pattern",
      "type": "string"
    },
    "forecast_length": {
      "default": 96,
      "exclusiveMinimum": 0,
      "title": "Forecast Length",
      "type": "integer"
    },
    "fp16": {
      "default": true,
      "title": "Fp16",
      "type": "boolean"
    },
    "freeze_backbone": {
      "default": false,
      "title": "Freeze Backbone",
      "type": "boolean"
    },
    "interval_mins": {
      "default": 5,
      "exclusiveMinimum": 0,
      "title": "Interval Mins",
      "type": "integer"
    },
    "learning_rate": {
      "default": 0.0001,
      "exclusiveMinimum": 0.0,
      "title": "Learning Rate",
      "type": "number"
    },
    "model_path": {
      "default": "Salesforce/moirai-1.0-R-small",
      "minLength": 1,
      "title": "Model Path",
      "type": "string"
    },
    "model_type": {
      "const": "moirai",
      "default": "moirai",
      "title": "Model Type",
      "type": "string"
    },
    "num_epochs": {
      "default": 10,
      "minimum": 0,
      "title": "Num Epochs",
      "type": "integer"
    },
    "num_samples": {
      "default": 100,
      "exclusiveMinimum": 0,
      "title": "Num Samples",
      "type": "integer"
    },
    "past_covariate_dim": {
      "default": 0,
      "minimum": 0,
      "title": "Past Covariate Dim",
      "type": "integer"
    },
    "patch_size": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "const": "auto",
          "type": "string"
        }
      ],
      "default": "auto",
      "title": "Patch Size"
    },
    "target_col": {
      "default": "bg_mM",
      "minLength": 1,
      "title": "Target Col",
      "type": "string"
    },
    "training_mode": {
      "default": "fine_tune",
      "enum": [
        "zero_shot",
        "fine_tune"
      ],
      "title": "Training Mode",
      "type": "string"
    },
    "use_cpu": {
      "default": false,
      "title": "Use Cpu",
      "type": "boolean"
    }
  },
  "title": "MoiraiModelConfigSchema",
  "type": "object"
}
